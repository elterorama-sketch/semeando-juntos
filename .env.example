# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import admin.ts from
# client components -- this key bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: protects /api/cron/expire-reservations from anonymous calls.
# Set the same value in Vercel's cron configuration if you rotate it.
CRON_SECRET=change-me

# Optional: used only by `npm run seed` to invite the first administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Nome do Administrador"
